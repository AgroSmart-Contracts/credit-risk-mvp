{
  "name": "credit-risk-mvp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "validate": "tsx scripts/validate-cram-coverage.ts",
    "test": "vitest run",
